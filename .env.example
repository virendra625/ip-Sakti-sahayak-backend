# IP-SAKTI Sahayak Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=true

# Database Configuration
# Default: Local SQLite (no installation required).
# For PostgreSQL via Docker: postgresql+psycopg2://postgres:postgres@localhost:5432/ipsakti
DATABASE_URL=sqlite:///./ip_sakti.db

# Vector Database (Qdrant)
# Docker: http://localhost:6333
# If local standalone or testing without Docker, local file storage is used
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ayurveda_ipr_documents

# LLM Provider Configuration
# Options: mock, gemini, openai
# 'mock' provides fully offline, deterministic, grounded answers without API costs.
LLM_PROVIDER=mock
LLM_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# Embedding Provider Configuration
# Options: mock, local, openai
# 'mock' produces deterministic 384-dimension embeddings for instant local execution.
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=

# Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
